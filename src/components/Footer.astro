---
import { academia, contacto, waLink } from '../data/academia';
import Txt from './Txt.astro';
import { url } from '../utils';
---
<footer class="on-dark bg-bordo-hondo px-[var(--gutter)] pb-28 pt-16 text-crema sm:pb-16">
  <div class="wrap grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="display h-lg">NR Academia</p>
      <p class="mt-4 max-w-sm opacity-85">Academia de pádel de {academia.profe} en {academia.sede}.</p>
    </div>
    <div>
      <p class="mb-3 font-bold">Clases</p>
      <ul class="space-y-1">
        {[['individuales', 'Individuales'], ['grupales', 'Grupales'], ['para-chicos', 'Para chicos'], ['competencia', 'Competencia']].map(([s, n]) => (
          <li><a class="inline-flex min-h-11 items-center underline-offset-4 hover:underline" href={url(`clases/${s}/`)}>{n}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="mb-3 font-bold">Contacto</p>
      <ul class="space-y-1">
        <li><a class="inline-flex min-h-11 items-center underline-offset-4 hover:underline" href={waLink()} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a class="inline-flex min-h-11 items-center underline-offset-4 hover:underline" href={contacto.tiktok.url} target="_blank" rel="noopener">TikTok {contacto.tiktok.usuario}</a></li>
        <li class="flex min-h-11 items-center opacity-80">{contacto.instagram.usuario}</li>
        <li class="flex min-h-11 items-center opacity-80">{contacto.youtube.usuario}</li>
      </ul>
    </div>
  </div>
  <div class="wrap mt-12 flex flex-col gap-2 border-t border-crema/25 pt-6 text-sm opacity-80 sm:flex-row sm:justify-between">
    <p>© {new Date().getFullYear()} NR Academia · <Txt value={contacto.direccion} /></p>
    <p>Sitio por CEDETEC</p>
  </div>
</footer>
