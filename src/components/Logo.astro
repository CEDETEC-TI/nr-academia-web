---
// Logo oficial (public/logo.svg = a-fino-cerca.svg, sin tocar): verde y amarillo, con "ACADEMIA NR" en verde oscuro.
// Sobre bordó o video el verde oscuro se pierde, así que va siempre sobre una pastilla crema (sobre crema no se nota).
import { url } from '../utils';
const { height = 44 } = Astro.props as { height?: number };
const inner = Math.round(height * 0.8);
const width = Math.round((inner * 564) / 256);
---
<span class="inline-grid shrink-0 place-items-center rounded-[22%] bg-crema px-[6%] shadow-[0_1px_2px_rgb(74_16_25/0.2)]" style={`height:${height}px`}>
  <img src={url('logo.svg')} alt="" width={width} height={inner} style={`height:${inner}px;width:auto`} decoding="async" />
</span>
