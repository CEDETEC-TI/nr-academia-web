---
import { waLink } from '../data/academia';
const { mensaje } = Astro.props as { mensaje?: string };
---
<a href={waLink(mensaje)} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp"
  class="wa-float fixed z-40 grid size-14 place-items-center rounded-full bg-[#1f6b3f] text-white shadow-[var(--shadow-lift)] " style="bottom:max(1rem,env(safe-area-inset-bottom));right:max(1rem,env(safe-area-inset-right))">
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" fill="currentColor"><path d="M16.04 3C9.4 3 4 8.4 4 15.03c0 2.12.55 4.18 1.6 6L4 29l8.2-1.56a12.03 12.03 0 0 0 3.84.62C22.68 28.06 28 22.66 28 16.03 28 9.4 22.68 3 16.04 3Zm0 22.1c-1.2 0-2.38-.3-3.42-.9l-.6-.35-4.86.93.98-4.72-.4-.62a9.04 9.04 0 0 1-1.4-4.8c0-4.97 4.1-9.02 9.14-9.02s9.14 4.05 9.14 9.02c0 4.98-4.1 9.46-9.14 9.46h.56Zm5.03-6.76c-.28-.14-1.63-.8-1.88-.9-.25-.1-.44-.14-.62.14-.18.27-.7.9-.86 1.08-.16.18-.32.2-.6.07-.27-.14-1.16-.43-2.2-1.36-.81-.72-1.36-1.62-1.52-1.9-.16-.27 0-.42.12-.56.12-.12.27-.32.4-.48.14-.16.18-.27.27-.46.1-.18.05-.34-.02-.48-.07-.14-.62-1.5-.85-2.05-.22-.54-.45-.46-.62-.47h-.53c-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.3 0 1.37.99 2.7 1.13 2.88.14.18 1.95 2.98 4.73 4.18.66.28 1.18.45 1.58.58.66.2 1.27.18 1.75.1.53-.08 1.63-.67 1.86-1.31.23-.64.23-1.19.16-1.31-.07-.12-.25-.18-.53-.32Z"/></svg>
</a>
<style>
  .wa-float { transition: transform 160ms var(--ease-out-strong); touch-action: manipulation; }
  .wa-float:active { transform: scale(0.94); }
  @media (hover: hover) { .wa-float:hover { transform: scale(1.06); } }
</style>
