---
import Base from '../layouts/Base.astro';
import '../styles/cuaderno.css';
---
<Base title="Cuaderno de Pádel · Academia NR" description="Registrá tus partidos, torneos, entrenamientos, físico y mental, y mirá tu progreso. Se guarda en tu navegador o, si entrás con tu cuenta, en la nube." app>
<div id="cuaderno">
<header class="top">
  <div class="wrap">
    <div class="brand">
      <h1>Cuaderno<br> de Pádel</h1>
      <span class="sub">Tu progreso en pádel</span>
    </div>
    <nav class="tabs" id="tabs">
      <a href="#inicio">Inicio</a>
      <a href="#partidos">Partidos</a>
      <a href="#torneos">Torneos</a>
      <a href="#entrenos">Entrenamientos</a>
      <a href="#fisico">Físico</a>
      <a href="#mental">Mental</a>
      <a href="#historial">Historial</a>
      <a href="#ficha">Ficha</a>
    </nav>
    <span class="status" id="status">Conectando…</span>
  </div>
</header>

<div class="cdn-main"><div class="wrap" id="view"></div><div class="nube" id="nube" hidden></div></div>
<div class="toast" id="toast" hidden></div>
</div>
<script>import '../scripts/cuaderno.js';</script>
</Base>
