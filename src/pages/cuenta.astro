---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
---
<Base title="Mi cuenta · Academia NR" description="Entrá o creá tu cuenta de Academia NR con Google o con tu mail para guardar tu ficha y tu Cuaderno de Pádel en la nube." noindex app>
  <section id="cuenta" class="cuenta">
    <div class="cwrap">
      <p id="c-estado" class="c-aviso" role="status" hidden></p>

      <!-- Sin cuenta: entrar / crear -->
      <div id="c-entrada" class="c-bloque" hidden>
        <h1 class="display h-lg">Tu cuenta</h1>
        <p class="c-lede">Con tu cuenta guardás el Cuaderno de Pádel en la nube y lo ves en el celu y en la compu.</p>
        <div class="c-tabs" role="tablist">
          <button type="button" role="tab" id="t-entrar" aria-selected="true" aria-controls="f-entrar">Entrar</button>
          <button type="button" role="tab" id="t-crear" aria-selected="false" aria-controls="f-crear">Crear cuenta</button>
        </div>
        <div id="c-google" class="c-google" hidden>
          <button type="button" class="btn-google" id="b-google">
            <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.2C12.4 13.5 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.6 5.9c4.4-4.1 7-10.1 7-17.6z"/><path fill="#FBBC05" d="M10.5 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.2C.9 16.5 0 20.1 0 24s.9 7.5 2.6 10.8l7.9-6.2z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4-13.5-9.9l-7.9 6.2C6.5 42.6 14.6 48 24 48z"/></svg>
            Continuar con Google
          </button>
          <p class="c-o"><span>o con tu mail</span></p>
        </div>
        <form id="f-entrar" class="c-form" novalidate>
          <label class="c-campo"><span>Email</span><input name="email" type="email" autocomplete="username" required /></label>
          <label class="c-campo"><span>Contraseña</span><input name="clave" type="password" autocomplete="current-password" required /></label>
          <button class="btn" type="submit">Entrar</button>
          <button class="c-link" type="button" id="b-olvide">Me olvidé la contraseña</button>
        </form>
        <form id="f-crear" class="c-form" novalidate hidden>
          <label class="c-campo"><span>Email</span><input name="email" type="email" autocomplete="username" required /></label>
          <label class="c-campo"><span>Contraseña (mínimo 8 caracteres)</span><input name="clave" type="password" autocomplete="new-password" minlength="8" required /></label>
          <button class="btn" type="submit">Crear mi cuenta</button>
          <p class="c-nota">Te mandamos un mail para confirmar la cuenta. Si no lo ves, mirá en spam.</p>
        </form>
        <form id="f-olvide" class="c-form" novalidate hidden>
          <p class="c-nota">Escribí tu mail y te mandamos un enlace para elegir una contraseña nueva.</p>
          <label class="c-campo"><span>Email</span><input name="email" type="email" autocomplete="username" required /></label>
          <button class="btn" type="submit">Enviar enlace</button>
          <button class="c-link" type="button" id="b-volver">Volver</button>
        </form>
      </div>

      <!-- Enlace del mail: se usa recién al tocar Continuar (los revisores de links no lo gastan) -->
      <div id="c-continuar" class="c-bloque" hidden>
        <h1 class="display h-lg">Ya casi</h1>
        <p class="c-lede" id="c-continuar-txt">Tocá el botón para seguir.</p>
        <button class="btn" type="button" id="b-continuar">Continuar</button>
      </div>

      <!-- Elegir contraseña nueva (llegó por el enlace del mail) -->
      <form id="f-nueva" class="c-form" novalidate hidden>
        <h1 class="display h-lg">Elegí tu contraseña nueva</h1>
        <label class="c-campo"><span>Contraseña nueva (mínimo 8 caracteres)</span><input name="clave" type="password" autocomplete="new-password" minlength="8" required /></label>
        <button class="btn" type="submit">Guardar contraseña</button>
      </form>

      <!-- Con sesión -->
      <div id="c-dentro" class="c-bloque" hidden>
        <h1 class="display h-lg">Hola 👋</h1>
        <p id="c-ficha-aviso" class="c-aviso" hidden>Todavía no completaste tu ficha técnica. Le sirve a Nacho para prepararte las clases.</p>
        <p class="c-lede">Entraste como <strong id="c-mail"></strong><span id="c-rol"></span>.</p>
        <div class="c-acciones">
          <a class="btn" href={url('cuenta/ficha/')}>Mi ficha técnica</a>
          <a class="btn btn-ghost" href={url('cuaderno/')}>Ir a mi Cuaderno</a>
          <a class="btn btn-ghost" id="c-panel" href={url('panel/')} hidden>Abrir el panel</a>
          <button class="btn btn-ghost" type="button" id="b-cambiar">Cambiar contraseña</button>
          <button class="btn btn-ghost" type="button" id="b-salir">Cerrar sesión</button>
        </div>
      </div>

      <p id="c-off" class="c-lede" hidden>Las cuentas todavía no están activas en este sitio.</p>
    </div>
  </section>
  <script>import '../scripts/cuenta';</script>
</Base>

<style is:global>
  .cuenta { min-height: 100svh; padding: clamp(7rem, 22vw, 8.5rem) var(--gutter) calc(7rem + env(safe-area-inset-bottom)); background: var(--color-crema); color: var(--color-tinta); }
  .cuenta .cwrap { max-width: 26rem; margin: 0 auto; display: grid; gap: 1.75rem; }
  .cuenta .c-bloque:not([hidden]) { display: grid; gap: 1.75rem; }
  .cuenta h1 { margin-bottom: .25rem; line-height: 1.02; }
  .cuenta .c-lede, .cuenta .c-nota { line-height: 1.6; }
  .cuenta .c-lede { color: var(--color-tinta-suave); }
  .cuenta .c-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; padding: .3rem; border-radius: 999px; background: rgb(109 26 42 / .08); }
  .cuenta .c-tabs button { min-height: 2.75rem; border-radius: 999px; font-weight: 700; color: var(--color-bordo); }
  .cuenta .c-tabs button[aria-selected='true'] { background: var(--color-bordo); color: var(--color-crema); }
  .cuenta .c-form { display: grid; gap: 1.25rem; }
  .cuenta .c-form .btn { margin-top: .25rem; }
  .cuenta .c-campo { display: grid; gap: .45rem; font-weight: 600; }
  .cuenta .c-campo input { font-size: 16px; padding: .9rem 1rem; border-radius: .9rem; background: #fff; border: 1.5px solid rgb(109 26 42 / .22); font-weight: 400; }
  .cuenta .c-campo input:focus { outline: none; border-color: var(--color-bordo); }
  .cuenta .c-link { justify-self: start; min-height: 2.75rem; text-decoration: underline; text-underline-offset: 3px; color: var(--color-bordo); font-weight: 600; }
  .cuenta .c-nota { font-size: .9rem; color: var(--color-tinta-suave); }
  .cuenta .c-aviso { padding: 1rem 1.15rem; border-radius: 1rem; background: rgb(109 26 42 / .09); font-weight: 600; line-height: 1.5; }
  .cuenta .c-aviso[data-tipo='error'] { background: #fff; color: var(--color-bordo); box-shadow: inset 0 0 0 1.5px var(--color-bordo); }
  .cuenta .c-aviso[data-tipo='ok'] { background: #e3f3e8; color: #1c5a34; }
  .cuenta .c-google { display: grid; gap: 1.5rem; }
  .cuenta .btn-google { display: flex; align-items: center; justify-content: center; gap: .7rem; min-height: 3.25rem; border-radius: 999px; background: #fff; color: var(--color-tinta); font-weight: 700; box-shadow: inset 0 0 0 1.5px rgb(109 26 42 / .3); touch-action: manipulation; transition: transform 160ms var(--ease-out-strong); }
  .cuenta .btn-google:active { transform: scale(.97); }
  @media (hover: hover) { .cuenta .btn-google:hover { background: var(--color-crema-oscura); } }
  .cuenta .c-o { display: flex; align-items: center; gap: .8rem; font-size: .9rem; color: var(--color-tinta-suave); }
  .cuenta .c-o::before, .cuenta .c-o::after { content: ''; flex: 1; height: 1px; background: rgb(109 26 42 / .2); }
  .cuenta .c-acciones { display: grid; gap: 1rem; margin-top: .5rem; }
  .cuenta .btn { min-height: 3.25rem; background: var(--color-bordo); color: var(--color-crema); justify-content: center; }
  .cuenta .btn-ghost { background: transparent; color: var(--color-bordo); box-shadow: inset 0 0 0 1.5px rgb(109 26 42 / .35); }
  .cuenta button:disabled { opacity: .6; }
</style>
