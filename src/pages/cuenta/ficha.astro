---
import Base from '../../layouts/Base.astro';
import { url } from '../../utils';
const GOLPES = ['Saque', 'Resto', 'Volea', 'Bandeja', 'Víbora', 'Remate', 'Globo', 'Salida de pared', 'Defensa', 'Posición en la cancha'];
---
<Base title="Mi ficha técnica · Academia NR" description="Tu ficha técnica de Academia NR." noindex app>
  <section id="ficha" class="ficha">
    <div class="fwrap">
      <p id="f-estado" class="f-aviso" role="status" hidden></p>

      <div id="f-sin" hidden>
        <h1 class="display h-lg">Mi ficha</h1>
        <p class="f-lede">Para completar tu ficha técnica primero tenés que entrar a tu cuenta.</p>
        <a class="f-btn" href={url('cuenta/')}>Entrar o crear cuenta</a>
      </div>
      <p id="f-off" class="f-lede" hidden>Las cuentas todavía no están activas en este sitio.</p>

      <form id="f-form" novalidate hidden>
        <h1 class="display h-lg">Mi ficha</h1>
        <p class="f-lede">Contale a Nacho cómo jugás para que te prepare las clases. Son 2 minutos y la podés cambiar cuando quieras.</p>

        <label class="f-campo"><span>Nombre</span><input name="nombre" type="text" autocomplete="name" maxlength="120" required /></label>
        <label class="f-campo"><span>Edad</span><input name="edad" type="number" inputmode="numeric" min="3" max="99" /></label>

        <fieldset class="f-grupo"><legend>Nivel</legend>
          <div class="f-opc">
            <label><input type="radio" name="nivel" value="principiante" /><span>Principiante</span></label>
            <label><input type="radio" name="nivel" value="intermedio" /><span>Intermedio</span></label>
            <label><input type="radio" name="nivel" value="avanzado" /><span>Avanzado</span></label>
          </div>
        </fieldset>
        <fieldset class="f-grupo"><legend>Mano hábil</legend>
          <div class="f-opc">
            <label><input type="radio" name="mano" value="derecha" /><span>Derecha</span></label>
            <label><input type="radio" name="mano" value="zurda" /><span>Zurda</span></label>
          </div>
        </fieldset>
        <fieldset class="f-grupo"><legend>Lado de la cancha en el que jugás</legend>
          <div class="f-opc">
            <label><input type="radio" name="lado" value="derecha" /><span>Derecha</span></label>
            <label><input type="radio" name="lado" value="reves" /><span>Revés</span></label>
          </div>
        </fieldset>

        <label class="f-campo"><span>¿Qué querés lograr?</span><textarea name="objetivo" rows="3" maxlength="1000" placeholder="Ej: ganar confianza, subir de categoría, jugar torneos"></textarea></label>
        <fieldset class="f-grupo"><legend>Golpes que querés mejorar</legend>
          <div class="f-opc">
            {GOLPES.map((g) => <label><input type="checkbox" name="golpes" value={g} /><span>{g}</span></label>)}
          </div>
        </fieldset>
        <label class="f-campo"><span>Lesiones o cuidados</span><textarea name="lesiones" rows="3" maxlength="1000" placeholder="Si no tenés ninguna, dejalo vacío"></textarea></label>
        <label class="f-campo"><span>Días y horarios en los que podés venir</span><textarea name="disponibilidad" rows="3" maxlength="1000" placeholder="Ej: martes y jueves a la tarde"></textarea></label>

        <button class="f-btn" type="submit">Guardar mi ficha</button>
        <a class="f-link" href={url('cuenta/')}>Volver a mi cuenta</a>
      </form>
    </div>
  </section>
  <script>import '../../scripts/ficha';</script>
</Base>

<style is:global>
  .ficha { min-height: 100svh; padding: 7rem var(--gutter) 4rem; background: var(--color-crema); color: var(--color-tinta); }
  .ficha .fwrap { max-width: 32rem; margin: 0 auto; display: grid; gap: 1.1rem; }
  .ficha form { display: grid; gap: 1.2rem; }
  .ficha .f-lede { color: var(--color-tinta-suave); }
  .ficha .f-campo { display: grid; gap: .3rem; font-weight: 600; }
  .ficha input[type='text'], .ficha input[type='number'], .ficha textarea { font: inherit; font-size: 16px; font-weight: 400; padding: .8rem 1rem; border-radius: .9rem; background: #fff; border: 1.5px solid rgb(109 26 42 / .22); width: 100%; }
  .ficha textarea { resize: vertical; min-height: 5.5rem; }
  .ficha input:focus-visible, .ficha textarea:focus-visible { outline: none; border-color: var(--color-bordo); }
  .ficha .f-grupo { border: 0; padding: 0; margin: 0; display: grid; gap: .5rem; min-width: 0; }
  .ficha legend { font-weight: 600; padding: 0; margin-bottom: .5rem; }
  .ficha .f-opc { display: flex; flex-wrap: wrap; gap: .5rem; }
  .ficha .f-opc label { position: relative; }
  .ficha .f-opc input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .ficha .f-opc span { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.1rem; border-radius: 999px; background: #fff; font-weight: 600; box-shadow: inset 0 0 0 1.5px rgb(109 26 42 / .25); transition: background-color 160ms, color 160ms; }
  .ficha .f-opc input:checked + span { background: var(--color-bordo); color: var(--color-crema); box-shadow: none; }
  .ficha .f-opc input:focus-visible + span { outline: 3px solid var(--color-arcilla); outline-offset: 3px; }
  .ficha .f-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 3.25rem; padding: .5rem 1.75rem; border-radius: 999px; background: var(--color-bordo); color: var(--color-crema); font-weight: 700; touch-action: manipulation; transition: transform 160ms var(--ease-out-strong); }
  .ficha .f-btn:active { transform: scale(.97); }
  .ficha .f-btn:disabled { opacity: .6; }
  .ficha .f-link { justify-self: start; min-height: 2.75rem; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 3px; color: var(--color-bordo); font-weight: 600; }
  .ficha .f-aviso { padding: .8rem 1rem; border-radius: 1rem; background: rgb(109 26 42 / .09); font-weight: 600; }
  .ficha .f-aviso[data-tipo='error'] { background: #fde8e6; color: #8a1a10; }
  .ficha .f-aviso[data-tipo='ok'] { background: #e3f3e8; color: #1c5a34; }
</style>
